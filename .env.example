# Analytics Configuration
# 以下の値を .env ファイルに設定してください

# Instagram
INSTAGRAM_GRAPH_TOKEN=your_instagram_graph_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id_here
GA4_MEASUREMENT_ID=your_ga4_measurement_id_here

# GitHub (自動設定済み)
# GITHUB_TOKEN は GitHub Actions から自動提供されます
